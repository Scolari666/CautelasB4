generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum CautelaStatus {
  ATIVA
  DEVOLVIDA
}

enum MissaoStatus {
  PLANEJADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum PedidoStatus {
  PENDENTE
  APROVADO
  RECUSADO
  ATENDIDO
}

model User {
  id           String    @id @default(cuid())
  name         String
  username     String    @unique
  matricula    String?
  graduacao    String?
  telefone     String?
  pelotao      String?
  avatarUrl    String?
  email        String?   @unique
  passwordHash String
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())
  cautelas     Cautela[]
  missoesCriadas    Missao[] @relation("MissaoCreatedBy")
  missoesAtribuidas Missao[] @relation("MissaoAssignedTo")
  pedidos           Pedido[]
  autosInfracao     AutoInfracao[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  items     Item[]
}

model Estoque {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  items     Item[]
}

model Item {
  id                  String    @id @default(cuid())
  name                String
  description         String?
  photo               String?
  categoryId          String
  category            Category  @relation(fields: [categoryId], references: [id])
  estoqueId           String
  estoque             Estoque   @relation(fields: [estoqueId], references: [id])
  quantityTotal       Int       @default(0)
  quantityAvailable   Int       @default(0)
  quantityCheckedOut  Int       @default(0)
  quantityUnavailable Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  cautelaItems        CautelaItem[]
  pedidoItems         PedidoItem[]
}

model Cautela {
  id                  String        @id @default(cuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id])
  purpose             String?
  takenAt             DateTime      @default(now())
  expectedReturnAt    DateTime?
  retiradoPorNome     String?
  retiradoPorTelefone String?
  items               CautelaItem[]
}

model CautelaItem {
  id          String        @id @default(cuid())
  cautelaId   String
  cautela     Cautela       @relation(fields: [cautelaId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item          @relation(fields: [itemId], references: [id])
  quantity    Int
  status      CautelaStatus @default(ATIVA)
  returnedAt  DateTime?
  returnNotes String?

  @@index([cautelaId])
  @@index([itemId])
}

model Missao {
  id           String       @id @default(cuid())
  title        String
  description  String?
  status       MissaoStatus @default(PLANEJADA)
  startAt      DateTime?
  endAt        DateTime?
  assignedToId String?
  assignedTo   User?        @relation("MissaoAssignedTo", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User         @relation("MissaoCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime     @default(now())

  @@index([assignedToId])
}

model Pedido {
  id            String       @id @default(cuid())
  pelotao       String
  instrucao     String
  neededAt      DateTime
  status        PedidoStatus @default(PENDENTE)
  notes         String?
  requestedById String
  requestedBy   User         @relation(fields: [requestedById], references: [id])
  createdAt     DateTime     @default(now())
  items         PedidoItem[]
}

model PedidoItem {
  id       String @id @default(cuid())
  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id])
  quantity Int

  @@index([pedidoId])
}

/// Anexo A — Auto de Infração de Segurança Contra Incêndio (CBMRS)
model AutoInfracao {
  id                   String   @id @default(cuid())
  numero               String
  dataLavratura        DateTime @default(now())
  horario              String?

  // Identificação da edificação ou área de risco de incêndio
  razaoSocial          String?
  nomeFantasia         String?
  ppciPspci            String?
  numeroLogradouro     String?
  logradouro           String?
  bairro               String?
  municipio            String?
  complemento          String?

  // Identificação do infrator (proprietário ou responsável pelo uso)
  infratorRazaoSocial  String?
  infratorCnpj         String?
  infratorNome         String?
  infratorCpf          String?
  infratorTelefone     String?
  infratorEmail        String?

  // Códigos das infrações marcadas, ex.: "LEVE_A", "MEDIA_F", "GRAVE_Q"
  infracoes            String[]

  createdById          String
  createdBy            User     @relation(fields: [createdById], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([createdById])
}
