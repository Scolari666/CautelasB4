generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum CautelaStatus {
  ATIVA
  DEVOLVIDA
}

model User {
  id           String    @id @default(cuid())
  name         String
  username     String    @unique
  matricula    String?
  graduacao    String?
  email        String?   @unique
  passwordHash String
  role         Role      @default(USER)
  createdAt    DateTime  @default(now())
  cautelas     Cautela[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  items     Item[]
}

model Estoque {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  items     Item[]
}

model Item {
  id                  String    @id @default(cuid())
  name                String
  description         String?
  photo               String?
  categoryId          String
  category            Category  @relation(fields: [categoryId], references: [id])
  estoqueId           String
  estoque             Estoque   @relation(fields: [estoqueId], references: [id])
  quantityTotal       Int       @default(0)
  quantityAvailable   Int       @default(0)
  quantityCheckedOut  Int       @default(0)
  quantityUnavailable Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  cautelaItems        CautelaItem[]
}

model Cautela {
  id                  String        @id @default(cuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id])
  purpose             String?
  takenAt             DateTime      @default(now())
  expectedReturnAt    DateTime?
  retiradoPorNome     String?
  retiradoPorTelefone String?
  items               CautelaItem[]
}

model CautelaItem {
  id          String        @id @default(cuid())
  cautelaId   String
  cautela     Cautela       @relation(fields: [cautelaId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item          @relation(fields: [itemId], references: [id])
  quantity    Int
  status      CautelaStatus @default(ATIVA)
  returnedAt  DateTime?
  returnNotes String?

  @@index([cautelaId])
  @@index([itemId])
}
